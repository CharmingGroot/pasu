# Rendered by run.sh. The ext_proc filter block is integrations/envoy/envoy.yaml's,
# with one knob opened up: @RESPONSE_BODY_MODE@ is BUFFERED for the supported
# setup and NONE for the misconfiguration pasu must refuse. The provider is the
# plain-HTTP mock instead of api.openai.com over TLS.
admin:
  address: { socket_address: { address: @ADMIN_ADDR@, port_value: @ADMIN_PORT@ } }
static_resources:
  listeners:
  - name: llm
    address: { socket_address: { address: @LISTEN_ADDR@, port_value: @LISTEN_PORT@ } }
    per_connection_buffer_limit_bytes: 67108864
    filter_chains:
    - filters:
      - name: envoy.filters.network.http_connection_manager
        typed_config:
          "@type": type.googleapis.com/envoy.extensions.filters.network.http_connection_manager.v3.HttpConnectionManager
          stat_prefix: llm
          route_config:
            virtual_hosts:
            - name: provider
              domains: ["*"]
              routes:
              - match: { prefix: "/" }
                route: { cluster: provider, auto_host_rewrite: true, timeout: 300s }
          http_filters:
          - name: envoy.filters.http.ext_proc
            typed_config:
              "@type": type.googleapis.com/envoy.extensions.filters.http.ext_proc.v3.ExternalProcessor
              grpc_service:
                envoy_grpc: { cluster_name: pasu }
                timeout: 10s
              failure_mode_allow: false
              message_timeout: 10s
              processing_mode:
                request_header_mode: SEND
                response_header_mode: SEND
                request_body_mode: BUFFERED
                response_body_mode: @RESPONSE_BODY_MODE@
          - name: envoy.filters.http.router
            typed_config:
              "@type": type.googleapis.com/envoy.extensions.filters.http.router.v3.Router
  clusters:
  - name: pasu
    type: STRICT_DNS
    dns_lookup_family: V4_ONLY
    typed_extension_protocol_options:
      envoy.extensions.upstreams.http.v3.HttpProtocolOptions:
        "@type": type.googleapis.com/envoy.extensions.upstreams.http.v3.HttpProtocolOptions
        explicit_http_config: { http2_protocol_options: {} }
    load_assignment:
      cluster_name: pasu
      endpoints: [{ lb_endpoints: [{ endpoint: { address: { socket_address: { address: @UPSTREAM_HOST@, port_value: @PASU_PORT@ } } } }] }]
  - name: provider
    type: LOGICAL_DNS
    dns_lookup_family: V4_ONLY
    per_connection_buffer_limit_bytes: 67108864
    load_assignment:
      cluster_name: provider
      endpoints: [{ lb_endpoints: [{ endpoint: { address: { socket_address: { address: @UPSTREAM_HOST@, port_value: @MOCK_PORT@ } } } }] }]
